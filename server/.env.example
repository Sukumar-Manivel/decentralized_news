# ==========================================
# CITIZENLENS ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/citizenlens?retryWrites=true&w=majority&appName=Cluster0

# JSON Web Token Secret Key & Expiry
JWT_SECRET=your_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Razorpay API Credentials (Test Mode for Demo)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Node Environment ('development' | 'production')
NODE_ENV=development
